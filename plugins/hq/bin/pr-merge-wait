#!/usr/bin/env bash
# SPDX-License-Identifier: MIT (see LICENSE at the repository root)
# pr-merge-wait — watch open pull requests until one merges, closes or starts
# conflicting, then report once and exit.
#
#   pr-merge-wait <pr-number|pr-url> [<pr> ...] [--repo owner/name]
#                 [--interval SECONDS] [--timeout DURATION] [--no-state]
#
# Exit codes: 0 a PR merged, 3 a PR was closed unmerged, 4 a PR went
# conflicting/behind, 5 timeout (all still open and clean), 2 usage or gh error.
#
# State files: after every successful read of a PR and on exit, writes
# ${PR_WATCH_STATE_DIR:-~/.cache/pr-watch}/<owner>__<repo>__<number>.merge-wait.json
# per PR (lowercase; checks is always [] as this watch does not read them).
# Needs jq, else skipped; best-effort and silent; --no-state turns it off.
#
# Why this exists: polling a PR from a model turn re-reads the whole context
# each time only to learn "still open, still clean". Started in the background
# (Claude Code's Bash run_in_background) this costs
# no tokens while it waits and wakes the model exactly once, with something to do.
# Sibling of pr-ci-wait: same arg style, same repo detection, same exit-code
# discipline. Stays silent between polls because its output is read by a model.

set -euo pipefail

PROG=${0##*/}

usage() {
	cat >&2 <<'USAGE'
usage: pr-merge-wait <pr-number|pr-url> [<pr> ...] [--repo owner/name]
                     [--interval SECONDS (default 120)]
                     [--timeout DURATION (default 12h; 90, 45s, 30m, 12h)]
                     [--no-state (do not write the state files)]

Silent while every watched PR stays open and clean; prints a handful of lines and
exits the moment one of them needs a coordinator action.

exit 0 merged | 3 closed unmerged | 4 conflicting/behind | 5 timeout | 2 usage or gh error
USAGE
}

die() {
	printf '%s: %s\n' "$PROG" "$1" >&2
	exit "${2:-2}"
}

progress() { printf '[%s] %s\n' "$PROG" "$1" >&2; }

REPO=""
TIMEOUT=43200
INTERVAL=120
MAX_FAILS=10
STATE_ON=1
TARGETS=()

parse_duration() {
	local raw=$1 num unit
	case "$raw" in
	*[0-9]) num=$raw unit=s ;;
	*[sS]) num=${raw%?} unit=s ;;
	*[mM]) num=${raw%?} unit=m ;;
	*[hH]) num=${raw%?} unit=h ;;
	*) die "--timeout must be seconds or a duration like 45s, 30m, 12h: $raw" ;;
	esac
	case "$num" in '' | *[!0-9]*) die "--timeout must be seconds or a duration like 45s, 30m, 12h: $raw" ;; esac
	# base 10 forced: 010 is ten seconds, and 08s/09m are not invalid octal
	num=$((10#$num))
	case "$unit" in
	s) printf '%s' "$num" ;;
	m) printf '%s' "$((num * 60))" ;;
	h) printf '%s' "$((num * 3600))" ;;
	esac
}

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--repo)
		[ $# -ge 2 ] || die "--repo needs a value"
		REPO=$2
		shift 2
		;;
	--repo=*)
		REPO=${1#--repo=}
		shift
		;;
	--timeout)
		[ $# -ge 2 ] || die "--timeout needs a value"
		TIMEOUT=$(parse_duration "$2")
		shift 2
		;;
	--timeout=*)
		TIMEOUT=$(parse_duration "${1#--timeout=}")
		shift
		;;
	--interval)
		[ $# -ge 2 ] || die "--interval needs a value"
		INTERVAL=$2
		shift 2
		;;
	--interval=*)
		INTERVAL=${1#--interval=}
		shift
		;;
	--no-state)
		STATE_ON=0
		shift
		;;
	-*) die "unknown flag: $1" ;;
	*)
		TARGETS+=("$1")
		shift
		;;
	esac
done

[ ${#TARGETS[@]} -gt 0 ] || {
	usage
	exit 2
}
case "$INTERVAL" in '' | *[!0-9]* | 0) die "--interval must be a positive whole number of seconds" ;; esac
INTERVAL=$((10#$INTERVAL))
[ "$TIMEOUT" -gt 0 ] || die "--timeout must be greater than zero"

command -v gh >/dev/null 2>&1 || die "gh is not on PATH"
command -v jq >/dev/null 2>&1 || STATE_ON=0

# A gh call that wedges must not outlive the watch, and macOS has no timeout(1);
# perl's alarm survives exec, so the bound holds on gh itself. One poll at most.
GH_TIMEOUT=$INTERVAL
if [ "$GH_TIMEOUT" -gt 60 ]; then GH_TIMEOUT=60; fi
if [ "$GH_TIMEOUT" -lt 5 ]; then GH_TIMEOUT=5; fi
if command -v perl >/dev/null 2>&1; then
	BOUND=(perl -e 'alarm shift; exec @ARGV' "$GH_TIMEOUT")
else
	BOUND=(env) # no perl: the calls run unbounded
fi

# --- resolve PR numbers and repos ------------------------------------------
PRS=()
PR_REPOS=()
URLS=()

for target in "${TARGETS[@]}"; do
	pr=""
	repo=$REPO
	case "$target" in
	http://* | https://*)
		pr=$(printf '%s\n' "$target" | sed -n 's#.*/pull/\([0-9][0-9]*\).*#\1#p')
		[ -n "$pr" ] || die "could not read a PR number out of URL: $target"
		repo=$(printf '%s\n' "$target" | sed -n 's#^https\{0,1\}://[^/]*/\([^/]*\)/\([^/]*\)/pull/.*#\1/\2#p')
		;;
	*[!0-9]*) die "arguments must be PR numbers or PR URLs: $target" ;;
	*) pr=$target ;;
	esac
	if [ -z "$repo" ]; then
		repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) ||
			die "no --repo given and the current directory has no GitHub remote"
		REPO=$repo
	fi
	PRS+=("$pr")
	PR_REPOS+=("$repo")
	URLS+=("https://github.com/$repo/pull/$pr")
done

N=${#PRS[@]}

# --- per-PR state ----------------------------------------------------------
STATE=()
MERGEABLE=()
MSS=()
SHA=()
REF=()
FAILS=()
FRESH=()
LAST_OK=()
LAST_ERR=()
EXTRA=()
i=0
while [ "$i" -lt "$N" ]; do
	STATE+=("OPEN")
	MERGEABLE+=("UNKNOWN")
	MSS+=("UNKNOWN")
	SHA+=("")
	REF+=("")
	FAILS+=("0")
	FRESH+=("0")
	LAST_OK+=("")
	LAST_ERR+=("")
	EXTRA+=("{}")
	i=$((i + 1))
done

FIELDS='state,mergeable,mergeStateStatus,mergeCommit,headRefName'
# Joined on "|", not a tab: tab is an IFS whitespace character, so `read` would
# collapse the empty mergeCommit of an unmerged PR and shift every later field.
QUERY='[.state, .mergeable, .mergeStateStatus, (.mergeCommit.oid // ""), .headRefName] | join("|")'
if [ "$STATE_ON" = 1 ]; then
	# Second output line for the state file.
	FIELDS="$FIELDS,headRefOid,title"
	QUERY="($QUERY), ({headRefOid, title} | tojson)"
fi

# --- state files and child processes ----------------------------------------
EXIT_REASON="exited"
STATE_TMP=""
CHILD_PID=""
XDIR=$(mktemp -d "${TMPDIR:-/tmp}/pr-merge-wait.XXXXXX") || die "cannot create a temporary directory"

# Runs "$@" with stdout in $XDIR/out and stderr in $XDIR/err. With state on it
# runs as a waited background child: bash holds a trapped signal until a
# foreground child exits, but `wait` returns at once.
xrun() {
	local rc=0
	if [ "$STATE_ON" = 1 ]; then
		"$@" </dev/null >"$XDIR/out" 2>"$XDIR/err" &
		CHILD_PID=$!
		wait "$CHILD_PID" || rc=$?
		CHILD_PID=""
	else
		"$@" >"$XDIR/out" 2>"$XDIR/err" || rc=$?
	fi
	return "$rc"
}

# A failing sleep still ends the script through set -e, as a foreground one would.
nap() {
	if [ "$STATE_ON" = 1 ]; then
		sleep "$1" &
		CHILD_PID=$!
		wait "$CHILD_PID"
		CHILD_PID=""
	else
		sleep "$1"
	fi
}

# $1: PR index, $2: exit code or empty while polling. Never fails, never prints.
# Nothing is written for a PR that has never been read successfully.
write_state() {
	[ "$STATE_ON" = 1 ] && [ -n "${LAST_OK[$1]}" ] || return 0
	case "${STATE[$1]}" in OPEN | MERGED | CLOSED) ;; *) return 0 ;; esac
	{
		local i=$1 f stale=true
		[ "${FRESH[$i]}" != 1 ] || stale=false
		f="${PR_WATCH_STATE_DIR:-$HOME/.cache/pr-watch}/$(printf '%s' "${PR_REPOS[$i]//\//__}" | tr '[:upper:]' '[:lower:]')__${PRS[$i]}.merge-wait.json"
		mkdir -p "${f%/*}" &&
			STATE_TMP=$(mktemp "${f}.tmp.XXXXXX") &&
			printf '%s' "${EXTRA[$i]:-"{}"}" | jq -c \
				--arg repo "${PR_REPOS[$i]}" --arg number "${PRS[$i]}" --argjson pid "$$" \
				--arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg url "${URLS[$i]}" \
				--arg state "${STATE[$i]}" --arg mergeable "${MERGEABLE[$i]}" --arg mss "${MSS[$i]}" \
				--argjson stale "$stale" --arg lastok "${LAST_OK[$i]}" \
				--arg code "${2:-}" --arg reason "$EXIT_REASON" '
				{version: 1, repo: $repo, number: ($number | tonumber), watcher: "merge-wait", pid: $pid,
				 updatedAt: $now, headSha: (.headRefOid // ""), url: $url, state: $state,
				 stale: $stale, lastOkAt: ($lastok | tonumber | todate),
				 mergeable: $mergeable, mergeStateStatus: $mss, checks: []}
				+ (if .title then {title} else {} end)
				| if $code != "" then .exited = {code: ($code | tonumber), at: $now, reason: $reason} else . end
				' >"$STATE_TMP" &&
			mv -f "$STATE_TMP" "$f"
		[ -z "$STATE_TMP" ] || rm -f "$STATE_TMP"
		STATE_TMP=""
	} >/dev/null 2>&1 || true
}

write_all() {
	local i=0
	while [ "$i" -lt "$N" ]; do
		write_state "$i" "$1"
		i=$((i + 1))
	done
}

# shellcheck disable=SC2329 # invoked by the EXIT trap
on_exit() {
	local code=$?
	write_all "$code"
	rm -rf "$XDIR" 2>/dev/null || true
}
# shellcheck disable=SC2329 # invoked by the signal traps
on_signal() { # <signal> <exit code>
	trap - EXIT "$1"
	[ -z "$CHILD_PID" ] || kill "$CHILD_PID" 2>/dev/null || true
	[ -z "$STATE_TMP" ] || rm -f "$STATE_TMP" 2>/dev/null || true
	STATE_TMP=""
	EXIT_REASON="killed by SIG$1"
	write_all "$2"
	rm -rf "$XDIR" 2>/dev/null || true
	kill -"$1" $$
}
trap on_exit EXIT
if [ "$STATE_ON" = 1 ]; then
	trap 'on_signal TERM 143' TERM
	trap 'on_signal INT 130' INT
	trap 'on_signal HUP 129' HUP
fi

# CONFLICTING, DIRTY and BEHIND all mean "rebase before this can land".
# mergeable UNKNOWN is no information at all — GitHub reports it while it
# recomputes the merge — and is never read as a change.
is_bad() {
	local mergeable=$1 mss=$2
	case "$mergeable" in
	CONFLICTING) return 0 ;;
	UNKNOWN) return 1 ;;
	esac
	case "$mss" in
	DIRTY | BEHIND) return 0 ;;
	esac
	return 1
}

pr_line() {
	local i=$1 line
	line=$(printf '%s  state=%s  mergeStateStatus=%s  branch=%s' \
		"${URLS[$i]}" "${STATE[$i]}" "${MSS[$i]}" "${REF[$i]}")
	[ -n "${SHA[$i]}" ] && line="$line  merge_commit=${SHA[$i]}"
	printf '%s\n' "$line"
}

open_others() {
	# branches of the still-open watched PRs, for the "rebase the rest" line
	local i=0 out=""
	while [ "$i" -lt "$N" ]; do
		if [ "${STATE[$i]}" = "OPEN" ] && [ -n "${REF[$i]}" ]; then
			out="$out ${REF[$i]}"
		fi
		i=$((i + 1))
	done
	printf '%s' "${out# }"
}

report() {
	local verdict=$1 hit=$2 elapsed=$3 i=0 rest stale now
	case "$verdict" in
	merged) EXIT_REASON="merged: ${URLS[$hit]}" ;;
	closed) EXIT_REASON="closed unmerged: ${URLS[$hit]}" ;;
	bad) EXIT_REASON="conflicting or behind: ${URLS[$hit]}" ;;
	*) EXIT_REASON="timeout" ;;
	esac
	while [ "$i" -lt "$N" ]; do
		pr_line "$i"
		i=$((i + 1))
	done
	case "$verdict" in
	merged)
		rest=$(open_others)
		printf 'next: git fetch origin main, rebase %s and re-verify CI, then continue the wave\n' \
			"${rest:-every remaining open wave branch}"
		exit 0
		;;
	closed)
		printf 'next: closed unmerged — stop work on %s and ask the owner before reopening or re-pushing\n' \
			"${REF[$hit]:-that branch}"
		exit 3
		;;
	bad)
		printf 'next: git fetch origin main, rebase %s on origin/main, push --force-with-lease, re-verify CI\n' \
			"${REF[$hit]:-that branch}"
		exit 4
		;;
	timeout)
		# States above are the last successful read. If the newest poll of a PR
		# failed, they may be stale: a merge during the outage looks like silence.
		stale=""
		now=$(date +%s)
		i=0
		while [ "$i" -lt "$N" ]; do
			if [ "${FRESH[$i]}" != 1 ]; then
				if [ -n "${LAST_OK[$i]}" ]; then
					stale="$stale ${URLS[$i]} (last good read $((now - LAST_OK[i]))s ago)"
				else
					stale="$stale ${URLS[$i]} (never read successfully)"
				fi
			fi
			i=$((i + 1))
		done
		if [ -n "$stale" ]; then
			printf 'next: state UNVERIFIED after %ss — the newest poll failed for:%s. Check with gh pr view <pr> --json state,mergeable,mergeStateStatus before acting on the states above, then re-arm pr-merge-wait in the background\n' \
				"$elapsed" "$stale"
			exit 5
		fi
		printf 'next: nothing — watched %ss, every PR above still open and clean; re-arm pr-merge-wait in the background if the wait should continue\n' \
			"$elapsed"
		exit 5
		;;
	esac
}

progress "watching $N PR(s) — interval=${INTERVAL}s timeout=${TIMEOUT}s; silent until something changes"

start=$(date +%s)
deadline=$((start + TIMEOUT))

while :; do
	i=0
	verdict=""
	hit=0
	fail_hit=-1
	while [ "$i" -lt "$N" ]; do
		gh_rc=0
		xrun "${BOUND[@]}" gh pr view "${PRS[$i]}" --repo "${PR_REPOS[$i]}" --json "$FIELDS" -q "$QUERY" || gh_rc=$?
		raw=$(cat "$XDIR/out" "$XDIR/err")
		if [ "$gh_rc" -eq 0 ]; then
			FAILS[i]=0
			FRESH[i]=1
			LAST_OK[i]=$(date +%s)
			IFS='|' read -r st mrg mss sha ref <<<"$raw"
			# from stdout only, so a gh warning on stderr cannot break it
			EXTRA[i]=$(sed -n 2p "$XDIR/out")
			STATE[i]=${st:-UNKNOWN}
			MERGEABLE[i]=${mrg:-UNKNOWN}
			MSS[i]=${mss:-UNKNOWN}
			SHA[i]=$sha
			REF[i]=$ref
			write_state "$i"
			# Precedence when several PRs move in the same poll: a merge subsumes
			# the others, since its next action rebases every remaining branch.
			case "${STATE[$i]}" in
			MERGED)
				if [ "$verdict" != merged ]; then
					verdict=merged
					hit=$i
				fi
				;;
			CLOSED)
				if [ -z "$verdict" ] || [ "$verdict" = bad ]; then
					verdict=closed
					hit=$i
				fi
				;;
			*)
				if is_bad "${MERGEABLE[$i]}" "${MSS[$i]}" && [ -z "$verdict" ]; then
					verdict=bad
					hit=$i
				fi
				;;
			esac
		else
			# Every failure is retried, the first one included: a wrong number and
			# a 502 look identical, and giving up on either loses whatever the
			# other PRs said this pass. Only MAX_FAILS in a row is fatal.
			FAILS[i]=$((FAILS[i] + 1))
			FRESH[i]=0
			LAST_ERR[i]=$raw
			[ "${FAILS[$i]}" -eq 1 ] && progress "gh failed on ${URLS[$i]} — retrying: $(printf '%s' "$raw" | tail -n 1)"
			[ "${FAILS[$i]}" -ge "$MAX_FAILS" ] && fail_hit=$i
			write_state "$i"
		fi
		i=$((i + 1))
	done

	# A merge, closure or conflict read from one PR outranks another PR's outage.
	[ -n "$verdict" ] && report "$verdict" "$hit" 0
	if [ "$fail_hit" -ge 0 ]; then
		printf '%s: gh failed %s times in a row on %s\n%s\n' \
			"$PROG" "${FAILS[$fail_hit]}" "${URLS[$fail_hit]}" "${LAST_ERR[$fail_hit]}" >&2
		EXIT_REASON="gh error: ${URLS[$fail_hit]}"
		exit 2
	fi

	now=$(date +%s)
	elapsed=$((now - start))
	remaining=$((deadline - now))
	[ "$remaining" -le 0 ] && report timeout 0 "$elapsed"
	if [ "$remaining" -lt "$INTERVAL" ]; then
		nap "$remaining"
	else
		nap "$INTERVAL"
	fi
done
